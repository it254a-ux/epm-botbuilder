/*
  Cache-Control: no-cache, no-store, must-revalidate
/splash/*
  Cache-Control: public, max-age=604800
/static/*
  Cache-Control: public, max-age=31536000, immutable
/owner/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; frame-ancestors 'none'
/admin/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; frame-ancestors 'none'
