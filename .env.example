# Signal machine settings. Copy each NAME into Vercel -> Project -> Settings -> Environment Variables.
# NEVER put real values in this file and NEVER commit real secrets to the repository.

# --- required ---
# A long random password that protects /api/signal-watch (make one, e.g. 40+ random letters and numbers).
SIGNALS_SECRET=
# Turso database (hosted SQLite): the address and the token from the Turso dashboard
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Telegram: token from @BotFather, and the chat id of your channel/group (looks like -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- optional (defaults shown) ---
# Markets to watch, comma separated Deriv symbols. Phase 1: keep it to ONE.
WATCH_SYMBOLS=frxEURUSD
# Candle size in seconds: 3600 = 1 hour (default), 900 = 15 minutes.
WATCH_TIMEFRAME=3600
# Which strategies to run (1 to 5).
WATCH_STRATEGIES=1,2,3,4,5
# Only send signals with at least this reward:risk.
MIN_RR=2
# Skip setups whose stop loss is closer than this many ATR to the entry (1 ATR = a normal hourly move). 0 = off.
MIN_STOP_ATR=1
# Skip setups whose reward is above this multiple of the risk. 0 = off.
MAX_RR=0
# Only send setups whose break of structure happened at most this many candles ago.
SIGNAL_MAX_AGE_CANDLES=3
# Send a signal only AFTER price touches the entry (on), or as soon as the setup is ready (off). Needs the cron job to run every minute.
ENTRY_TOUCH=on
# A touch older than this many minutes is too late: the setup is dropped quietly.
ENTRY_FRESH_MINUTES=5
# How many candles a ready setup may wait for price to reach its entry.
ENTRY_WAIT_CANDLES=24
# While a setup waits for its entry, one run keeps checking every WATCH_POLL_SECONDS for up to WATCH_LOOP_SECONDS (keep under 50; 0 = one check per run).
WATCH_LOOP_SECONDS=48
WATCH_POLL_SECONDS=8
# Result messages: amounts RISKED per trade shown in the result (comma separated, up to 5), and hours before an unfinished signal is closed.
# RESULT_STAKES=10,20,50
# RESULT_EXPIRY_HOURS=24
# Your public site address, used for the link under each Telegram signal (goes to /signals.html).
# SITE_URL=https://www.executiveprimemarkets.site
# M15 direction + M5 entry mode (separate cron job, every 5 minutes). MTF_ENABLED=off switches it off.
MTF_ENABLED=on
# After a signal, no new M15 + M5 signal for the same market for this many minutes.
MTF_COOLDOWN_MIN=30
# ICT strategy (liquidity sweep + structure shift + fair value gap) runs inside the same 5-minute M15+M5 watcher. ICT_ENABLED=off switches only ICT off.
ICT_ENABLED=on
# News filter (free ForexFactory calendar feed). Set NEWS_FILTER=off to disable.
NEWS_FILTER=on
# Which impact levels count: high, or high,medium.
NEWS_IMPACT=high
# Hold signals from this many minutes before to this many minutes after a high-impact event.
NEWS_BLACKOUT_BEFORE_MIN=120
NEWS_BLACKOUT_AFTER_MIN=30
# Add a warning line to a signal when high-impact news is due within this many hours.
NEWS_WARN_HOURS=24
# How often the calendar is re-downloaded (hours); it is cached in the database in between.
NEWS_REFRESH_HOURS=6
# Only change if Deriv gives you a different public WebSocket address.
# DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public

# --- already used by the rest of the site (listed so nothing is missed) ---
# GEMINI_API_KEY=
