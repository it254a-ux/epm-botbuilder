# Signal machine settings. Copy each NAME into Vercel -> Project -> Settings -> Environment Variables.
# NEVER put real values in this file and NEVER commit real secrets to the repository.

# --- required ---
# A long random password that protects /api/signal-watch (make one, e.g. 40+ random letters and numbers).
SIGNALS_SECRET=
# Neon database connection string (already set for the rest of the site).
DATABASE_URL=
# Telegram: token from @BotFather, and the chat id of your channel/group (looks like -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- optional (defaults shown) ---
# Markets to watch, comma separated Deriv symbols. Phase 1: keep it to ONE.
WATCH_SYMBOLS=frxEURUSD
# Candle size in seconds: 900 = 15 minutes.
WATCH_TIMEFRAME=900
# Which strategies to run (1 to 5).
WATCH_STRATEGIES=1,2,3,4,5
# Only send signals with at least this reward:risk.
MIN_RR=2
# Only send setups whose break of structure happened at most this many candles ago.
SIGNAL_MAX_AGE_CANDLES=3
# Only change if Deriv gives you a different public WebSocket address.
# DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public

# --- already used by the rest of the site (listed so nothing is missed) ---
# GEMINI_API_KEY=
