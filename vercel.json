{
    "installCommand": "npm install --legacy-peer-deps",
    "functions": {
        "api/site-settings.js": {
            "maxDuration": 60
        },
        "api/signal-watch.js": {
            "includeFiles": "api/_lib/fonts/**",
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/owner",
            "destination": "/owner/index.html"
        },
        {
            "source": "/admin",
            "destination": "/admin/index.html"
        },
        {
            "source": "/api/signals",
            "destination": "/api/signal-watch?route=feed"
        },
        {
            "source": "/api/signal-admin",
            "destination": "/api/signal-watch?route=admin"
        },
        {
            "source": "/api/signal-backtest",
            "destination": "/api/signal-watch?route=backtest"
        },
        {
            "source": "/api/migrate-neon",
            "destination": "/api/signal-watch?route=migrate-neon"
        },
        {
            "source": "/api/signal-watch-mtf",
            "destination": "/api/signal-watch?route=watch-mtf"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/splash/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800"
                }
            ]
        },
        {
            "source": "/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(owner|admin)(/.*)?",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; frame-ancestors 'none'"
                }
            ]
        }
    ]
}
