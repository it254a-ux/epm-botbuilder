{
  "name": "epm-botbuilder",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  // Keep the variables you add in the Cloudflare dashboard (TURSO_DATABASE_URL, TURSO_AUTH_TOKEN, ...)
  // when the site is redeployed. Without this, each deploy can wipe them and the Bots page shows
  // "TURSO_DATABASE_URL is not set".
  "keep_vars": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/owner", "/admin"]
  },
  "alias": {
    "@libsql/client": "@libsql/client/web",
    "@resvg/resvg-js": "./worker/stubs/resvg.js",
    "@neondatabase/serverless": "./worker/stubs/neon.js"
  }
}
